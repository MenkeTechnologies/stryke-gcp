## t/test_gcp.stk — assertion tests for the stryke `GCP` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Requires the cdylib to be loaded — install once with `s pkg install -g .`
## so stryke's FFI bridge dlopens `lib/libstryke_gcp.{dylib,so}` on `use GCP`.
## Service-dependent assertions fire only when GCP credentials are reachable
## (`gcloud auth application-default login`) and the relevant
## $STRYKE_GCP_TEST_BUCKET / _TOPIC / _SUB env var is set.

use GCP
use GCP::Storage
use GCP::PubSub

# ── permission-free: cdylib reachable ───────────────────────────────
val $version = GCP::version()
assert_ok $version, "GCP::version returns truthy (cdylib loaded)"

# ── credentials probe ───────────────────────────────────────────────
val $alive = eval { GCP::ping() }

if ($alive) {
    val $id = GCP::identity()
    assert_ok $id->{ok}, "identity returns ok=true"

    # buckets list (read-only, low blast radius)
    val @bs = GCP::Storage::buckets()
    assert_ok 1, "Storage::buckets returns without dying (saw " . scalar(@bs) . ")"

    # ── GCS round-trip ───────────────────────────────────────────
    val $bucket = $ENV{STRYKE_GCP_TEST_BUCKET}
    if (defined $bucket) {
        val $key = "stryke-gcp-test/$$/" . time() . ".txt"
        val $uri = "gs://$bucket/$key"
        val $body = "hello-from-stryke-gcp-$$"

        val $put = GCP::Storage::put($uri, data => $body)
        assert_ok defined $put->{key}, "gcs put returns key"
        assert_eq GCP::Storage::get($uri), $body, "gcs get round-trip"
        assert_eq GCP::Storage::head($uri)->{size}, len($body), "gcs head size"
        GCP::Storage::rm($uri)
        assert_ok 1, "gcs rm completed without dying"
    }

    # ── Pub/Sub round-trip ──────────────────────────────────────
    val $topic = $ENV{STRYKE_GCP_TEST_TOPIC}
    val $sub   = $ENV{STRYKE_GCP_TEST_SUB}
    if (defined $topic && defined $sub) {
        val $body = "msg-from-stryke-gcp-$$-" . time()
        val $sent = GCP::PubSub::publish($topic, $body)
        assert_ok defined $sent->{message_id}, "pubsub publish returns message_id"

        sleep 2
        val @msgs = GCP::PubSub::pull($sub, max => 10, ack => 1)
        val $found = grep { $_->{data} eq $body } @msgs
        assert_ok $found, "pubsub pull returns our message"
    }
}

# ── pure helpers (no GCP — always run) ───────────────────────────────
val $gs = GCP::parse_gs_uri("gs://my-bucket/path/to/file.json")
assert_eq $gs->{bucket}, "my-bucket",         "parse_gs_uri: bucket"
assert_eq $gs->{object}, "path/to/file.json", "parse_gs_uri: object"
assert_ok !defined(GCP::parse_gs_uri("gs://only-bucket")->{object}), "parse_gs_uri: bucket-only object undef"

# build_gs_uri: inverse of parse_gs_uri; bare bucket when object omitted.
assert_eq GCP::build_gs_uri("my-bucket", "path/to/file.json"), "gs://my-bucket/path/to/file.json", "build_gs_uri: bucket+object"
assert_eq GCP::build_gs_uri("my-bucket"), "gs://my-bucket", "build_gs_uri: bare bucket when object omitted"
assert_eq GCP::build_gs_uri("my-bucket", "/leading"), "gs://my-bucket/leading", "build_gs_uri: trims leading slash on object"

# gs_uri_to_url: gs:// URI → path-style public URL.
val $u2u = GCP::gs_uri_to_url("gs://my-bucket/path/to/file.json")
assert_eq $u2u->{url}, "https://storage.googleapis.com/my-bucket/path/to/file.json", "gs_uri_to_url: object URL"
assert_eq $u2u->{object}, "path/to/file.json",                                       "gs_uri_to_url: object extracted"
assert_eq GCP::gs_uri_to_url("gs://my-bucket")->{url}, "https://storage.googleapis.com/my-bucket", "gs_uri_to_url: bucket endpoint"

# url_to_gs_uri: GCS download URL → gs:// URI (inverse of gs_uri_to_url).
val $u2g = GCP::url_to_gs_uri("https://storage.googleapis.com/my-bucket/path/to/file.json")
assert_eq $u2g->{uri}, "gs://my-bucket/path/to/file.json", "url_to_gs_uri: path-style → URI"
assert_eq $u2g->{object}, "path/to/file.json",             "url_to_gs_uri: object extracted"
assert_eq GCP::url_to_gs_uri("https://my-bucket.storage.googleapis.com/a/b.txt")->{uri}, "gs://my-bucket/a/b.txt", "url_to_gs_uri: virtual-hosted-style → URI"
assert_eq GCP::url_to_gs_uri(GCP::gs_uri_to_url("gs://b/k")->{url})->{uri}, "gs://b/k", "url_to_gs_uri: round-trips gs_uri_to_url"
assert_dies fn { GCP::url_to_gs_uri("https://example.com/b/k") }, "url_to_gs_uri: rejects non-GCS host"

val $rn = GCP::parse_resource_name("projects/my-proj/topics/orders")
assert_eq $rn->{pairs}{projects}, "my-proj", "parse_resource_name: project"
assert_eq $rn->{pairs}{topics},   "orders",  "parse_resource_name: topic"
assert_ok !defined($rn->{trailing}),         "parse_resource_name: even path no trailing"

# build_resource_name: inverse of parse_resource_name.
assert_eq GCP::build_resource_name(parts => ["projects", "p", "topics", "t"]), "projects/p/topics/t", "build_resource_name: from flat parts"
assert_eq GCP::build_resource_name(pairs => [["projects", "p"], ["secrets", "s"]], trailing => "versions"), "projects/p/secrets/s/versions", "build_resource_name: pairs + trailing"
assert_eq GCP::build_resource_name(%{ GCP::parse_resource_name("projects/my-proj/topics/orders") }), "projects/my-proj/topics/orders", "build_resource_name: round-trips parse via parts"
assert_dies fn { GCP::build_resource_name(parts => ["a/b", "c"]) }, "build_resource_name: rejects a segment containing '/'"

# parse_table_ref: BigQuery fully-qualified table reference (standard vs legacy).
val $std = GCP::parse_table_ref("my-proj.sales.orders")
assert_eq $std->{project}, "my-proj", "parse_table_ref: standard project"
assert_eq $std->{dataset}, "sales",   "parse_table_ref: standard dataset"
assert_eq $std->{table},   "orders",  "parse_table_ref: standard table"
assert_eq $std->{legacy},  0,         "parse_table_ref: dotted form is not legacy"
val $leg = GCP::parse_table_ref("my-proj:sales.orders")
assert_eq $leg->{project}, "my-proj", "parse_table_ref: legacy project (colon)"
assert_eq $leg->{legacy},  1,         "parse_table_ref: colon form is legacy"
val $bare = GCP::parse_table_ref("sales.orders")
assert_ok !defined($bare->{project}), "parse_table_ref: project-less dataset.table"
assert_eq $bare->{table}, "orders",   "parse_table_ref: bare form keeps table"
assert_dies fn { GCP::parse_table_ref("orders") },      "parse_table_ref: rejects a bare table"
assert_dies fn { GCP::parse_table_ref("a:b:c.d") },     "parse_table_ref: rejects two colons"

# build_table_ref: inverse of parse_table_ref.
assert_eq GCP::build_table_ref(dataset => "sales", table => "orders", project => "my-proj")->{table_ref}, "my-proj.sales.orders", "build_table_ref: standard dotted form"
assert_eq GCP::build_table_ref(dataset => "sales", table => "orders", project => "my-proj", legacy => 1)->{table_ref}, "my-proj:sales.orders", "build_table_ref: legacy colon form"
assert_eq GCP::build_table_ref(dataset => "sales", table => "orders")->{table_ref}, "sales.orders", "build_table_ref: project-less"
assert_eq GCP::build_table_ref(%{ GCP::parse_table_ref("my-proj:sales.orders") })->{table_ref}, "my-proj:sales.orders", "build_table_ref: round-trips a parsed ref"
assert_dies fn { GCP::build_table_ref(table => "orders") },                              "build_table_ref: requires a dataset"
assert_dies fn { GCP::build_table_ref(dataset => "a.b", table => "orders") },            "build_table_ref: rejects a separator in a segment"
assert_dies fn { GCP::build_table_ref(dataset => "sales", table => "orders", legacy => 1) }, "build_table_ref: legacy needs a project"

assert_ok GCP::valid_bucket_name("my_data.bucket-1")->{valid}, "valid_bucket_name: underscores legal in GCS"
val $g = GCP::valid_bucket_name("goog-private")
assert_eq $g->{valid}, 0, "valid_bucket_name: rejects goog prefix"
assert_match qr/goog/, $g->{reason}, "valid_bucket_name: reason names the rule"

# valid_project_id: GCP project ID rules.
assert_ok GCP::valid_project_id("my-project-123")->{valid},  "valid_project_id: legal"
assert_ok GCP::valid_project_id("abcdef")->{valid},          "valid_project_id: exactly 6 chars"
assert_eq GCP::valid_project_id("short")->{valid}, 0,        "valid_project_id: under 6 chars fails"
assert_eq GCP::valid_project_id("1starts")->{valid}, 0,      "valid_project_id: must start with a letter"
assert_eq GCP::valid_project_id("Upper-case")->{valid}, 0,   "valid_project_id: rejects uppercase"
val $pe = GCP::valid_project_id("ends-with-dash-")
assert_eq $pe->{valid}, 0,                                   "valid_project_id: trailing hyphen fails"
assert_match qr/hyphen/, $pe->{reason},                      "valid_project_id: reason names the rule"
assert_eq GCP::valid_project_id("has_underscore")->{valid}, 0, "valid_project_id: underscore not allowed"

# valid_object_name: GCS object-name hard rules.
assert_ok GCP::valid_object_name("dir/sub/file.txt")->{valid}, "valid_object_name: ordinary key with slashes"
assert_eq GCP::valid_object_name("")->{valid}, 0,             "valid_object_name: empty rejected"
assert_eq GCP::valid_object_name(".")->{valid}, 0,           "valid_object_name: rejects bare dot"
assert_eq GCP::valid_object_name("..")->{valid}, 0,          "valid_object_name: rejects double dot"
assert_ok GCP::valid_object_name("...")->{valid},            "valid_object_name: triple dot is fine"
assert_eq GCP::valid_object_name(".well-known/acme-challenge/tok")->{valid}, 0, "valid_object_name: rejects ACME challenge prefix"
assert_eq GCP::valid_object_name("a\nb")->{valid}, 0,        "valid_object_name: rejects line feed"
assert_dies fn { GCP::valid_object_name() }, "valid_object_name: dies on missing name"

# region_for_zone: GCP zone → region (strip the trailing -<letter>).
val $z = GCP::region_for_zone("us-central1-a")
assert_eq $z->{region},      "us-central1", "region_for_zone: us-central1-a → us-central1"
assert_eq $z->{zone_letter}, "a",           "region_for_zone: zone letter split out"
assert_eq GCP::region_for_zone("europe-west4-b")->{region},    "europe-west4",    "region_for_zone: multi-hyphen region"
assert_eq GCP::region_for_zone("asia-northeast1-c")->{region}, "asia-northeast1", "region_for_zone: asia region"
assert_dies fn { GCP::region_for_zone("uscentral1") },     "region_for_zone: rejects a zone with no hyphen"
assert_dies fn { GCP::region_for_zone("us-central1-ab") }, "region_for_zone: rejects a multi-char suffix"

# valid_label: GCP Resource Manager label key/value rules.
assert_ok GCP::valid_label("env", "prod")->{valid},          "valid_label: lowercase key/value"
assert_ok GCP::valid_label("cost-center_1", "team-a")->{valid}, "valid_label: dashes/underscores allowed"
assert_ok GCP::valid_label("team", "")->{valid},             "valid_label: empty value allowed"
assert_eq GCP::valid_label("1env", "x")->{valid}, 0,         "valid_label: key must start with a letter"
assert_eq GCP::valid_label("Env", "x")->{valid}, 0,          "valid_label: key rejects uppercase"
assert_eq GCP::valid_label("env", "Prod")->{valid}, 0,       "valid_label: value rejects uppercase"

# valid_pubsub_id: Pub/Sub topic/subscription/schema/snapshot naming rules.
assert_ok GCP::valid_pubsub_id("my-topic")->{valid},               "valid_pubsub_id: ordinary id"
assert_ok GCP::valid_pubsub_id("orders.v2_dlq~1+a%20")->{valid},   "valid_pubsub_id: full allowed punctuation"
assert_eq GCP::valid_pubsub_id("ab")->{valid}, 0,                  "valid_pubsub_id: under 3 chars rejected"
assert_eq GCP::valid_pubsub_id("1topic")->{valid}, 0,             "valid_pubsub_id: must start with a letter"
assert_eq GCP::valid_pubsub_id("googtopic")->{valid}, 0,         "valid_pubsub_id: goog prefix reserved"
assert_ok GCP::valid_pubsub_id("Googtopic")->{valid},             "valid_pubsub_id: capital Goog is not the reserved prefix"
assert_eq GCP::valid_pubsub_id("has space")->{valid}, 0,         "valid_pubsub_id: space rejected"
assert_eq GCP::valid_pubsub_id("slash/no")->{valid}, 0,          "valid_pubsub_id: slash rejected"
assert_dies fn { GCP::valid_pubsub_id() }, "valid_pubsub_id: dies on missing id"

# valid_dataset_id: BigQuery dataset naming rules.
assert_ok GCP::valid_dataset_id("my_dataset")->{valid},     "valid_dataset_id: letters/digits/underscores"
assert_ok GCP::valid_dataset_id("MyDataset2025")->{valid},  "valid_dataset_id: case preserved"
assert_ok GCP::valid_dataset_id("_hidden")->{valid},        "valid_dataset_id: leading underscore (hidden) allowed"
assert_eq GCP::valid_dataset_id("with-hyphen")->{valid}, 0, "valid_dataset_id: hyphen rejected"
assert_eq GCP::valid_dataset_id("has space")->{valid}, 0,   "valid_dataset_id: space rejected"
assert_eq GCP::valid_dataset_id("tbl.name")->{valid}, 0,    "valid_dataset_id: dot rejected"
assert_eq GCP::valid_dataset_id("")->{valid}, 0,            "valid_dataset_id: empty rejected"
assert_dies fn { GCP::valid_dataset_id() }, "valid_dataset_id: dies on missing id"

# valid_table_id: broader than dataset (allows dashes, spaces, Unicode; byte-capped).
assert_ok GCP::valid_table_id("my-table 2025")->{valid}, "valid_table_id: dashes and spaces allowed"
assert_ok GCP::valid_table_id("café_table")->{valid},    "valid_table_id: Unicode letters allowed"
assert_eq GCP::valid_table_id("café_table")->{bytes}, 11, "valid_table_id: counts UTF-8 bytes (é is 2)"
assert_eq GCP::valid_table_id("tbl.name")->{valid}, 0,    "valid_table_id: dot (separator) rejected"
assert_eq GCP::valid_table_id("")->{valid}, 0,            "valid_table_id: empty rejected"
assert_dies fn { GCP::valid_table_id() }, "valid_table_id: dies on missing id"

test_run
