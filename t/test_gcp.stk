## t/test_gcp.stk — assertion tests for the stryke `GCP` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Requires the cdylib to be loaded — install once with `s pkg install -g .`
## so stryke's FFI bridge dlopens `lib/libstryke_gcp.{dylib,so}` on `use GCP`.
## Service-dependent assertions fire only when GCP credentials are reachable
## (`gcloud auth application-default login`) and the relevant
## $STRYKE_GCP_TEST_BUCKET / _TOPIC / _SUB env var is set.

use GCP
use GCP::Storage
use GCP::PubSub

# ── permission-free: cdylib reachable ───────────────────────────────
val $version = GCP::version()
assert_ok $version, "GCP::version returns truthy (cdylib loaded)"

# ── credentials probe ───────────────────────────────────────────────
val $alive = eval { GCP::ping() }

if ($alive) {
    val $id = GCP::identity()
    assert_ok $id->{ok}, "identity returns ok=true"

    # buckets list (read-only, low blast radius)
    val @bs = GCP::Storage::buckets()
    assert_ok 1, "Storage::buckets returns without dying (saw " . scalar(@bs) . ")"

    # ── GCS round-trip ───────────────────────────────────────────
    val $bucket = $ENV{STRYKE_GCP_TEST_BUCKET}
    if (defined $bucket) {
        val $key = "stryke-gcp-test/$$/" . time() . ".txt"
        val $uri = "gs://$bucket/$key"
        val $body = "hello-from-stryke-gcp-$$"

        val $put = GCP::Storage::put($uri, data => $body)
        assert_ok defined $put->{key}, "gcs put returns key"
        assert_eq GCP::Storage::get($uri), $body, "gcs get round-trip"
        assert_eq GCP::Storage::head($uri)->{size}, len($body), "gcs head size"
        GCP::Storage::rm($uri)
        assert_ok 1, "gcs rm completed without dying"
    }

    # ── Pub/Sub round-trip ──────────────────────────────────────
    val $topic = $ENV{STRYKE_GCP_TEST_TOPIC}
    val $sub   = $ENV{STRYKE_GCP_TEST_SUB}
    if (defined $topic && defined $sub) {
        val $body = "msg-from-stryke-gcp-$$-" . time()
        val $sent = GCP::PubSub::publish($topic, $body)
        assert_ok defined $sent->{message_id}, "pubsub publish returns message_id"

        sleep 2
        val @msgs = GCP::PubSub::pull($sub, max => 10, ack => 1)
        val $found = grep { $_->{data} eq $body } @msgs
        assert_ok $found, "pubsub pull returns our message"
    }
}

# ── pure helpers (no GCP — always run) ───────────────────────────────
val $gs = GCP::parse_gs_uri("gs://my-bucket/path/to/file.json")
assert_eq $gs->{bucket}, "my-bucket",         "parse_gs_uri: bucket"
assert_eq $gs->{object}, "path/to/file.json", "parse_gs_uri: object"
assert_ok !defined(GCP::parse_gs_uri("gs://only-bucket")->{object}), "parse_gs_uri: bucket-only object undef"

# build_gs_uri: inverse of parse_gs_uri; bare bucket when object omitted.
assert_eq GCP::build_gs_uri("my-bucket", "path/to/file.json"), "gs://my-bucket/path/to/file.json", "build_gs_uri: bucket+object"
assert_eq GCP::build_gs_uri("my-bucket"), "gs://my-bucket", "build_gs_uri: bare bucket when object omitted"
assert_eq GCP::build_gs_uri("my-bucket", "/leading"), "gs://my-bucket/leading", "build_gs_uri: trims leading slash on object"

# gs_uri_to_url: gs:// URI → path-style public URL.
val $u2u = GCP::gs_uri_to_url("gs://my-bucket/path/to/file.json")
assert_eq $u2u->{url}, "https://storage.googleapis.com/my-bucket/path/to/file.json", "gs_uri_to_url: object URL"
assert_eq $u2u->{object}, "path/to/file.json",                                       "gs_uri_to_url: object extracted"
assert_eq GCP::gs_uri_to_url("gs://my-bucket")->{url}, "https://storage.googleapis.com/my-bucket", "gs_uri_to_url: bucket endpoint"

# url_to_gs_uri: GCS download URL → gs:// URI (inverse of gs_uri_to_url).
val $u2g = GCP::url_to_gs_uri("https://storage.googleapis.com/my-bucket/path/to/file.json")
assert_eq $u2g->{uri}, "gs://my-bucket/path/to/file.json", "url_to_gs_uri: path-style → URI"
assert_eq $u2g->{object}, "path/to/file.json",             "url_to_gs_uri: object extracted"
assert_eq GCP::url_to_gs_uri("https://my-bucket.storage.googleapis.com/a/b.txt")->{uri}, "gs://my-bucket/a/b.txt", "url_to_gs_uri: virtual-hosted-style → URI"
assert_eq GCP::url_to_gs_uri(GCP::gs_uri_to_url("gs://b/k")->{url})->{uri}, "gs://b/k", "url_to_gs_uri: round-trips gs_uri_to_url"
assert_dies fn { GCP::url_to_gs_uri("https://example.com/b/k") }, "url_to_gs_uri: rejects non-GCS host"

val $rn = GCP::parse_resource_name("projects/my-proj/topics/orders")
assert_eq $rn->{pairs}{projects}, "my-proj", "parse_resource_name: project"
assert_eq $rn->{pairs}{topics},   "orders",  "parse_resource_name: topic"
assert_ok !defined($rn->{trailing}),         "parse_resource_name: even path no trailing"

assert_ok GCP::valid_bucket_name("my_data.bucket-1")->{valid}, "valid_bucket_name: underscores legal in GCS"
val $g = GCP::valid_bucket_name("goog-private")
assert_eq $g->{valid}, 0, "valid_bucket_name: rejects goog prefix"
assert_match qr/goog/, $g->{reason}, "valid_bucket_name: reason names the rule"

test_run
