#!/usr/bin/env stryke
# examples/gcs_put_get.stk — round-trip a string through GCS.
# Run:   s examples/gcs_put_get.stk gs://my-bucket/demo.txt

use GCP::Storage

val $uri = $ARGV[0]
die "usage: gcs_put_get.stk gs://bucket/key\n" unless defined $uri

val $body = "hello from stryke at " . time()
val $r = GCP::Storage::put($uri, data => $body)
p "put: " . to_json($r)

val $back = GCP::Storage::get $uri
p "get: $back"

p "match: " . ($back eq $body ? "yes" : "no")

GCP::Storage::rm($uri)
p "deleted"
