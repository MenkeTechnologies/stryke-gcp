#!/usr/bin/env stryke
# examples/gcs_browse.stk — list a GCS prefix.
# Run:   s examples/gcs_browse.stk gs://my-bucket/prefix/

use GCP::Storage

val $uri = $ARGV[0]
die "usage: gcs_browse.stk gs://bucket/prefix\n" unless defined $uri

val @entries = GCP::Storage::ls $uri, delimiter => "/"
for val $e (@entries) {
    if ($e->{type} eq "prefix") {
        p "  [dir] $e->{key}"
    } else {
        p sprintf("  [obj] %10d  %s", $e->{size} // 0, $e->{key})
    }
}
