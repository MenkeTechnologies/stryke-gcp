## lib/Storage.stk — `use GCP::Storage`
##
## URI-flavored wrappers around `GCP::gcs_*` from the v0.2.0 cdylib.
## Object URIs use the standard `gs://bucket/key` form.

package GCP::Storage

use GCP

## Internal: parse `gs://bucket/key` → ($bucket, $key). `$key` may be "".
fn GCP::Storage::_parse ($uri) {
    die "GCP::Storage: expected gs://bucket/key, got `$uri`" unless $uri =~ m{^gs://([^/]+)/?(.*)$}
    ($1, $2)
}

## Returns an array of object hashrefs under the URI prefix.
## Each row: { name, size, content_type }.
fn GCP::Storage::ls ($uri, %opts) {
    val ($bucket, $prefix) = GCP::Storage::_parse($uri)
    GCP::gcs_list_objects($bucket, prefix => $prefix, %opts)
}

## Returns the object's body as a scalar string. Pass `output => "PATH"`
## to write to a file and get the path back.
fn GCP::Storage::get ($uri, %opts) {
    val ($bucket, $key) = GCP::Storage::_parse($uri)
    val $body = GCP::gcs_get_object($bucket, $key, %opts)
    if (defined $opts{output}) {
        open val $fh, ">", $opts{output} or die "GCP::Storage::get: open $opts{output}: $!"
        print $fh $body
        close $fh
        return $opts{output}
    }
    $body
}

## Upload a scalar or local file. Pass `data => $bytes` OR `input => "/path"`.
## Returns the put-object response hash.
fn GCP::Storage::put ($uri, %opts) {
    val ($bucket, $key) = GCP::Storage::_parse($uri)
    var $body
    if (defined $opts{data}) {
        $body = $opts{data}
    } elsif (defined $opts{input}) {
        open val $fh, "<", $opts{input} or die "GCP::Storage::put: open $opts{input}: $!"
        local $/
        $body = <$fh>
        close $fh
    } else {
        die "GCP::Storage::put: pass data => \$bytes or input => \"path\""
    }
    if (defined $opts{cache_control}) {
        die "GCP::Storage::put: cache_control deferred in v0.2.0 cdylib — extend gcp__gcs_put_object"
    }
    GCP::gcs_put_object($bucket, $key, $body, %opts)
}

## Object metadata for a gs:// URI (size, content_type, updated, md5_hash, …).
fn GCP::Storage::head ($uri, %opts) {
    val ($bucket, $key) = GCP::Storage::_parse($uri)
    GCP::gcs_head_object($bucket, $key, %opts)
}

## Server-side copy one gs:// URI to another.
fn GCP::Storage::cp ($src_uri, $dst_uri, %opts) {
    val ($sb, $sk) = GCP::Storage::_parse($src_uri)
    val ($db, $dk) = GCP::Storage::_parse($dst_uri)
    GCP::gcs_copy_object($sb, $sk, $db, $dk, %opts)
}

## Delete an object.
fn GCP::Storage::rm ($uri, %opts) {
    val ($bucket, $key) = GCP::Storage::_parse($uri)
    GCP::gcs_delete_object($bucket, $key, %opts) ? { deleted => 1 } : { deleted => 0 }
}

## Buckets in the configured project — array of bucket name strings.
fn GCP::Storage::buckets (%opts) {
    GCP::gcs_list_buckets(%opts)
}

