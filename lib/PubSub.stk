## lib/PubSub.stk — `use GCP::PubSub`
##
## Wraps `GCP::pubsub_*` from the v0.2.0 cdylib. Topic / subscription
## names can be bare (e.g. "my-topic") or fully qualified
## ("projects/PROJECT/topics/my-topic") — the latter form is stripped to
## the bare name before calling the cdylib, since the cdylib resolves
## the project from `project` opt / $GOOGLE_CLOUD_PROJECT itself.

package GCP::PubSub

use GCP

## Internal: strip `projects/PROJECT/topics/` or `subscriptions/` prefix.
fn GCP::PubSub::_bare ($name) {
    $name =~ s{^projects/[^/]+/(topics|subscriptions)/}{}
    $name
}

## Publish a single message. Returns an array of message IDs (usually one).
## `attrs => \%attrs` is supported. `ordering_key` is deferred in v0.2.0.
fn GCP::PubSub::publish ($topic, $data, %opts) {
    if (defined $opts{ordering_key}) {
        die "GCP::PubSub::publish: ordering_key deferred in v0.2.0 cdylib — extend gcp__pubsub_publish"
    }
    my $bare = GCP::PubSub::_bare($topic)
    my %args = %opts
    if (defined $opts{attrs}) {
        $args{attributes} = $opts{attrs}
    }
    GCP::pubsub_publish($bare, $data, %args)
}

## Pull. Pass `ack => 1` to auto-acknowledge received messages.
## Returns array of message hashrefs ({ ack_id, message_id, data, attributes }).
fn GCP::PubSub::pull ($subscription, %opts) {
    if (defined $opts{deadline}) {
        die "GCP::PubSub::pull: deadline deferred in v0.2.0 cdylib — extend gcp__pubsub_pull"
    }
    my $bare = GCP::PubSub::_bare($subscription)
    my @msgs = GCP::pubsub_pull($bare, %opts)
    if ($opts{ack} && @msgs) {
        my @ids = grep { defined } map { $_->{ack_id} } @msgs
        GCP::pubsub_ack($bare, \@ids, %opts) if @ids
    }
    @msgs
}

## Acknowledge one or more ack IDs. `$ids` is an arrayref or scalar.
fn GCP::PubSub::ack ($subscription, $ids, %opts) {
    my $list = ref($ids) eq "ARRAY" ? $ids : [$ids]
    my $bare = GCP::PubSub::_bare($subscription)
    GCP::pubsub_ack($bare, $list, %opts)
}

## List topics in the configured project. Deferred in v0.2.0.
fn GCP::PubSub::topics (%opts) {
    die "GCP::PubSub::topics: deferred in v0.2.0 cdylib — add gcp__pubsub_list_topics to the export list"
}

## List subscriptions in the configured project. Deferred in v0.2.0.
fn GCP::PubSub::subs (%opts) {
    die "GCP::PubSub::subs: deferred in v0.2.0 cdylib — add gcp__pubsub_list_subscriptions to the export list"
}

## Convenience: pull → callback → ack each message. Returns count handled.
fn GCP::PubSub::pump ($subscription, %opts) {
    die "GCP::PubSub::pump: callback => sub { … } is required" unless defined $opts{callback}
    my $cb = $opts{callback}
    my $iters = $opts{iterations} // 1
    my $n = 0
    for (1 .. $iters) {
        my @msgs = GCP::PubSub::pull($subscription, %opts)
        last unless @msgs
        my @acks
        for my $m (@msgs) {
            $cb->($m)
            push @acks, $m->{ack_id} if defined $m->{ack_id}
            $n++
        }
        if (@acks) {
            GCP::PubSub::ack($subscription, \@acks, %opts)
        }
    }
    $n
}

1
