fn GCP::logging_list_entries (%opts) {
    val $r = GCP::_req(
        { filter => $opts{filter}, page_size => $opts{page_size}, order => $opts{order} }, \%opts)
    @{ GCP::_decode("logging_list_entries", gcp__logging_list_entries(to_json($r)))->{entries} }
}

## Write a single log entry to $log. opts: text => $str OR json => \%payload,
## severity (default "DEFAULT"). Returns { log, written }.
fn GCP::logging_write_entry ($log, %opts) {
    val $r = GCP::_req(
        { log => $log, text => $opts{text}, json => $opts{json}, severity => $opts{severity} }, \%opts)
    GCP::_decode("logging_write_entry", gcp__logging_write_entry(to_json($r)))
}

## List the log ids that have entries in the project. Returns an array of strings.
fn GCP::logging_list_logs (%opts) {
    @{ GCP::_decode("logging_list_logs", gcp__logging_list_logs(to_json(GCP::_req({}, \%opts))))->{logs} }
}

