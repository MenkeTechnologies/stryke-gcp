## lib/GCP.stk — Google Cloud client for stryke (`use GCP`).
##
## Thin wrapper around the `stryke-gcp` cdylib's `gcp__*` exports.
## The cdylib is dlopened in-process on first `use GCP` (see stryke's
## `pkg/commands.rs::try_load_ffi_for`) and registers each export as a
## stryke-callable function via `rust_ffi::load_cdylib`.
##
## Replaces the v1 helper-binary model (fork(2) + exec(2) + fresh ADC
## discovery + auth token fetch per call). The cdylib holds one shared
## tokio runtime + reqwest client + credentials handle for the life of
## the process.
##
## v0.2.0 surface: GCS (list_buckets, list_objects, get/put/delete_object)
## + Pub/Sub (publish, pull, ack) + identity. The v1 helper's BigQuery and
## broader op set can be added incrementally.

package GCP

# ── error dispatch ────────────────────────────────────────────────────

## Decode the cdylib's JSON return; die on `{error}` payload.
fn GCP::_decode ($name, $json) {
    val $o = from_json $json
    if (ref $o eq "HASH" && exists $o->{error}) {
        die "GCP::$name: $o->{error}"
    }
    $o
}

## Build the FFI request hash by merging the caller's connection opts.
fn GCP::_req ($extra, $opts) {
    var %r = %$extra
    $r{project} = $opts->{project} if exists $opts->{project} && defined $opts->{project}
    \%r
}

# ── version + identity ───────────────────────────────────────────────

## Return the package version string.
fn GCP::version {
    GCP::_decode("pkg_version", gcp__pkg_version("{}"))->{version}
}

## Probe credentials — returns { ok, project, credentials_source }.
fn GCP::identity (%opts) {
    GCP::_decode("identity",
        gcp__identity(to_json(GCP::_req({}, \%opts))))
}

## Connectivity probe — returns 1 on success, 0 on failure.
fn GCP::ping (%opts) {
    eval { GCP::identity(%opts); 1 } ? 1 : 0
}

# ── GCS ──────────────────────────────────────────────────────────────

## List GCS buckets in the active project.
fn GCP::gcs_list_buckets (%opts) {
    val $o = GCP::_decode("gcs_list_buckets",
        gcp__gcs_list_buckets(to_json(GCP::_req({}, \%opts))))
    @{ $o->{buckets} }
}

## List GCS objects under $bucket with `prefix => "..."`.
fn GCP::gcs_list_objects ($bucket, %opts) {
    val $r = GCP::_req({ bucket => $bucket, prefix => $opts{prefix} }, \%opts)
    val $o = GCP::_decode("gcs_list_objects", gcp__gcs_list_objects(to_json($r)))
    @{ $o->{objects} }
}

## Download object body as scalar (string or `base64:...` for binary).
fn GCP::gcs_get_object ($bucket, $key, %opts) {
    val $r = GCP::_req({ bucket => $bucket, key => $key }, \%opts)
    GCP::_decode("gcs_get_object", gcp__gcs_get_object(to_json($r)))->{body}
}

## Upload $body to gs://$bucket/$key.
fn GCP::gcs_put_object ($bucket, $key, $body, %opts) {
    val $r = GCP::_req(
        { bucket => $bucket, key => $key, body => $body,
          content_type => $opts{content_type} },
        \%opts
    )
    GCP::_decode("gcs_put_object", gcp__gcs_put_object(to_json($r)))
}

## Delete gs://$bucket/$key. Returns 1 on success.
fn GCP::gcs_delete_object ($bucket, $key, %opts) {
    val $r = GCP::_req({ bucket => $bucket, key => $key }, \%opts)
    GCP::_decode("gcs_delete_object", gcp__gcs_delete_object(to_json($r)))->{deleted} ? 1 : 0
}

## Object metadata for gs://$bucket/$key (size, content_type, updated, …).
fn GCP::gcs_head_object ($bucket, $key, %opts) {
    val $r = GCP::_req({ bucket => $bucket, key => $key }, \%opts)
    GCP::_decode("gcs_head_object", gcp__gcs_head_object(to_json($r)))
}

## Server-side copy gs://$src_bucket/$src_key → gs://$dst_bucket/$dst_key.
fn GCP::gcs_copy_object ($src_bucket, $src_key, $dst_bucket, $dst_key, %opts) {
    val $r = GCP::_req(
        { src_bucket => $src_bucket, src_key => $src_key,
          dst_bucket => $dst_bucket, dst_key => $dst_key }, \%opts)
    GCP::_decode("gcs_copy_object", gcp__gcs_copy_object(to_json($r)))
}

# ── Pub/Sub ──────────────────────────────────────────────────────────

## Publish to topic. Returns array of message IDs.
fn GCP::pubsub_publish ($topic, $data, %opts) {
    val $r = GCP::_req(
        { topic => $topic, data => $data, attributes => ($opts{attributes} // {}) },
        \%opts
    )
    val $o = GCP::_decode("pubsub_publish", gcp__pubsub_publish(to_json($r)))
    @{ $o->{message_ids} }
}

## Pull up to `max` messages from subscription.
fn GCP::pubsub_pull ($subscription, %opts) {
    val $r = GCP::_req(
        { subscription => $subscription, max => ($opts{max} // 1) },
        \%opts
    )
    val $o = GCP::_decode("pubsub_pull", gcp__pubsub_pull(to_json($r)))
    @{ $o->{messages} }
}

## Acknowledge an arrayref of ack IDs.
fn GCP::pubsub_ack ($subscription, $ack_ids, %opts) {
    val $list = ref($ack_ids) eq "ARRAY" ? $ack_ids : [$ack_ids]
    val $r = GCP::_req(
        { subscription => $subscription, ack_ids => $list },
        \%opts
    )
    GCP::_decode("pubsub_ack", gcp__pubsub_ack(to_json($r)))->{acked}
}

## List topic names in the active project.
fn GCP::pubsub_list_topics (%opts) {
    val $o = GCP::_decode("pubsub_list_topics", gcp__pubsub_list_topics(to_json(GCP::_req({}, \%opts))))
    @{ $o->{topics} }
}

## List subscriptions ({ name, topic }) in the active project.
fn GCP::pubsub_list_subscriptions (%opts) {
    val $o = GCP::_decode("pubsub_list_subscriptions",
        gcp__pubsub_list_subscriptions(to_json(GCP::_req({}, \%opts))))
    @{ $o->{subscriptions} }
}

## Create topic $topic in the active project.
fn GCP::pubsub_create_topic ($topic, %opts) {
    GCP::_decode("pubsub_create_topic",
        gcp__pubsub_create_topic(to_json(GCP::_req({ topic => $topic }, \%opts))))
}

## Create subscription $subscription on $topic. opts: ack_deadline (default 10).
fn GCP::pubsub_create_subscription ($subscription, $topic, %opts) {
    val $r = GCP::_req(
        { subscription => $subscription, topic => $topic, ack_deadline => $opts{ack_deadline} }, \%opts)
    GCP::_decode("pubsub_create_subscription", gcp__pubsub_create_subscription(to_json($r)))
}

## Get one Pub/Sub topic's full resource. Returns { topic, resource }.
fn GCP::pubsub_get_topic ($topic, %opts) {
    val $r = GCP::_req({ topic => $topic }, \%opts)
    GCP::_decode("pubsub_get_topic", gcp__pubsub_get_topic(to_json($r)))
}

## List the subscription ids attached to $topic. Returns an array of strings.
fn GCP::pubsub_topic_subscriptions ($topic, %opts) {
    val $r = GCP::_req({ topic => $topic }, \%opts)
    @{ GCP::_decode("pubsub_topic_subscriptions", gcp__pubsub_topic_subscriptions(to_json($r)))->{subscriptions} }
}

# ── Secret Manager ───────────────────────────────────────────────────

## Access a secret's payload. opts: version (default "latest"). Returns the
## decoded secret value string.
fn GCP::secret_access ($secret, %opts) {
    val $r = GCP::_req({ secret => $secret, version => $opts{version} }, \%opts)
    GCP::_decode("secret_access", gcp__secret_access(to_json($r)))->{value}
}

## Create a new (empty) secret with automatic replication.
fn GCP::secret_create ($secret, %opts) {
    GCP::_decode("secret_create",
        gcp__secret_create(to_json(GCP::_req({ secret => $secret }, \%opts))))
}

## Add a new version holding $value to $secret. Returns the version response.
fn GCP::secret_add_version ($secret, $value, %opts) {
    val $r = GCP::_req({ secret => $secret, value => $value }, \%opts)
    GCP::_decode("secret_add_version", gcp__secret_add_version(to_json($r)))
}

## List the versions of $secret (newest first). Returns an array of
## { name, state, create_time } hashrefs.
fn GCP::secret_list_versions ($secret, %opts) {
    val $r = GCP::_req({ secret => $secret }, \%opts)
    @{ GCP::_decode("secret_list_versions", gcp__secret_list_versions(to_json($r)))->{versions} }
}

## Delete $secret and all its versions. Returns 1 on success.
fn GCP::secret_delete ($secret, %opts) {
    val $r = GCP::_req({ secret => $secret }, \%opts)
    GCP::_decode("secret_delete", gcp__secret_delete(to_json($r)))->{deleted} ? 1 : 0
}

## Delete a Pub/Sub topic.
fn GCP::pubsub_delete_topic ($topic, %opts) {
    GCP::_decode("pubsub_delete_topic",
        gcp__pubsub_delete_topic(to_json(GCP::_req({ topic => $topic }, \%opts))))
}

## Delete a Pub/Sub subscription.
fn GCP::pubsub_delete_subscription ($subscription, %opts) {
    GCP::_decode("pubsub_delete_subscription",
        gcp__pubsub_delete_subscription(to_json(GCP::_req({ subscription => $subscription }, \%opts))))
}

## Run a standard-SQL BigQuery query. opts: max_results, timeout_ms.
## Returns { columns, rows, total_rows, complete }.
fn GCP::bigquery_query ($query, %opts) {
    val $r = GCP::_req(
        { query => $query, max_results => $opts{max_results}, timeout_ms => $opts{timeout_ms} }, \%opts)
    GCP::_decode("bigquery_query", gcp__bigquery_query(to_json($r)))
}

## Stream-insert $rows (arrayref of hashrefs) into BigQuery $dataset.$table.
## Returns { inserted, errors }.
fn GCP::bigquery_insert ($dataset, $table, $rows, %opts) {
    die "GCP::bigquery_insert: rows must be an arrayref" unless ref($rows) eq "ARRAY"
    val $r = GCP::_req({ dataset => $dataset, table => $table, rows => $rows }, \%opts)
    GCP::_decode("bigquery_insert", gcp__bigquery_insert(to_json($r)))
}

## Compose (concatenate) $sources GCS objects into $destination in $bucket.
## Returns { bucket, object, size }.
fn GCP::gcs_compose ($bucket, $destination, $sources, %opts) {
    die "GCP::gcs_compose: sources must be an arrayref" unless ref($sources) eq "ARRAY"
    val $r = GCP::_req(
        { bucket => $bucket, destination => $destination, sources => $sources }, \%opts)
    GCP::_decode("gcs_compose", gcp__gcs_compose(to_json($r)))
}

# ── Firestore ────────────────────────────────────────────────────────

## Get a Firestore document. Returns { collection, document, data, update_time };
## data is undef when the document doesn't exist.
fn GCP::firestore_get ($collection, $document, %opts) {
    val $r = GCP::_req({ collection => $collection, document => $document }, \%opts)
    GCP::_decode("firestore_get", gcp__firestore_get(to_json($r)))
}

## Create-or-overwrite a Firestore document with $data (a hashref). Field
## values are auto-encoded to Firestore's typed format. Returns { ..., update_time }.
fn GCP::firestore_set ($collection, $document, $data, %opts) {
    die "GCP::firestore_set: data must be a hashref" unless ref($data) eq "HASH"
    val $r = GCP::_req(
        { collection => $collection, document => $document, data => $data }, \%opts)
    GCP::_decode("firestore_set", gcp__firestore_set(to_json($r)))
}

## Delete a Firestore document. Returns { collection, document, deleted }.
fn GCP::firestore_delete ($collection, $document, %opts) {
    val $r = GCP::_req({ collection => $collection, document => $document }, \%opts)
    GCP::_decode("firestore_delete", gcp__firestore_delete(to_json($r)))
}

## List documents in a $collection ({ id, data }). opt page_size (default 100).
fn GCP::firestore_list ($collection, %opts) {
    val $r = GCP::_req({ collection => $collection, page_size => $opts{page_size} }, \%opts)
    @{ GCP::_decode("firestore_list", gcp__firestore_list(to_json($r)))->{documents} }
}

## Query a $collection with an optional single field filter. opts: field, op
## (==, !=, <, <=, >, >=, in, array_contains; default ==), value, limit.
## Returns matching { id, data } documents.
fn GCP::firestore_query ($collection, %opts) {
    val $r = GCP::_req(
        { collection => $collection, field => $opts{field}, op => $opts{op},
          value => $opts{value}, limit => $opts{limit} }, \%opts)
    @{ GCP::_decode("firestore_query", gcp__firestore_query(to_json($r)))->{documents} }
}

## Create a document in $collection with $data (hashref). opt `document` sets
## the id; otherwise Firestore auto-generates one. Returns { collection, id }.
fn GCP::firestore_create ($collection, $data, %opts) {
    die "GCP::firestore_create: data must be a hashref" unless ref($data) eq "HASH"
    val $r = GCP::_req(
        { collection => $collection, data => $data, document => $opts{document} }, \%opts)
    GCP::_decode("firestore_create", gcp__firestore_create(to_json($r)))
}

