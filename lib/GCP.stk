# lib/GCP.stk — Google Cloud client plumbing for stryke.
#
# Wraps the `stryke-gcp-helper` Rust binary (REST-based, ADC-authed) and
# parses its JSON / NDJSON output. Per-service modules (AWS-style):
#   use AWS::S3-style                 use GCP::Storage
#                                     use GCP::PubSub
#
# Auth uses Application Default Credentials — same chain as the `gcloud`
# CLI: `$GOOGLE_APPLICATION_CREDENTIALS` file, `gcloud auth
# application-default login`, or the metadata server on GCE / Cloud Run.
#
# Internal helpers pass `$o` as a hashref rather than flattening `%opts`
# (stryke %opts-reslurp drops opts across required-file fn boundaries).

package GCP

our $HELPER

fn GCP::pkg_root {
    my @parts = split "/", __FILE__
    pop @parts
    pop @parts
    my $root = join "/", @parts
    $root ne "" ? $root : "."
}

fn GCP::helper_path {
    return $GCP::HELPER if defined $GCP::HELPER && -x $GCP::HELPER

    if (exists $ENV{STRYKE_GCP_HELPER} && $ENV{STRYKE_GCP_HELPER} ne "") {
        my $p = $ENV{STRYKE_GCP_HELPER}
        die "stryke-gcp: STRYKE_GCP_HELPER=$p is not an executable file" unless -x $p
        $GCP::HELPER = $p
        return $p
    }

    my $root = GCP::pkg_root()
    for my $cand (
        "$root/target/release/stryke-gcp-helper",
        "$root/target/debug/stryke-gcp-helper",
        "$root/bin/stryke-gcp-helper",
    ) {
        if (-x $cand) {
            $GCP::HELPER = $cand
            return $cand
        }
    }

    my $which = qx{command -v stryke-gcp-helper 2>/dev/null}
    chomp $which
    if ($which ne "" && -x $which) {
        $GCP::HELPER = $which
        return $which
    }

    die "stryke-gcp: helper binary not found.\n" .
        "  Build it once with:  cd $root && cargo build --release\n" .
        "  Or set STRYKE_GCP_HELPER=/path/to/stryke-gcp-helper\n"
}

fn GCP::ensure_built {
    my $root = GCP::pkg_root()
    for my $cand ("$root/target/release/stryke-gcp-helper",
                  "$root/target/debug/stryke-gcp-helper") {
        return $cand if -x $cand
    }
    return GCP::helper_path() if exists $ENV{STRYKE_GCP_HELPER}

    p "stryke-gcp: building helper (cargo build --release)..."
    my $rc = system "cd " . GCP::_shq($root) . " && cargo build --release"
    die "stryke-gcp: cargo build failed (rc=$rc)" if $rc != 0
    GCP::helper_path()
}

fn GCP::_shq ($s) {
    my $t = $s
    $t =~ s/'/'\\''/g
    "'$t'"
}

# Helper + global flags. $o hashref.
fn GCP::_conn_argv ($o) {
    my @argv = (GCP::_shq(GCP::helper_path()))
    push @argv, "--project", GCP::_shq($o->{project}) if defined $o->{project}
    @argv
}

fn GCP::_drain_ndjson ($fh) {
    my @rows
    while (my $line = <$fh>) {
        chomp $line
        next if $line eq ""
        push @rows, from_json $line
    }
    @rows
}

fn GCP::_run_ndjson ($argv) {
    my $cmd = join " ", @$argv
    if ($ENV{STRYKE_GCP_DEBUG}) {
        warn "DEBUG gcp cmd: $cmd\n"
    }
    open my $fh, "-|", $cmd or die "stryke-gcp: spawn failed: $!"
    my @rows = GCP::_drain_ndjson $fh
    close $fh or die "stryke-gcp: helper exited ($?)"
    @rows
}

fn GCP::_run_json ($argv) {
    my $cmd = join " ", @$argv
    if ($ENV{STRYKE_GCP_DEBUG}) {
        warn "DEBUG gcp cmd: $cmd\n"
    }
    my $out = qx{$cmd}
    die "stryke-gcp: helper exited ($?)" if $? != 0
    from_json $out
}

fn GCP::_run_raw ($argv) {
    my $cmd = join " ", @$argv
    if ($ENV{STRYKE_GCP_DEBUG}) {
        warn "DEBUG gcp cmd: $cmd\n"
    }
    my $out = qx{$cmd}
    die "stryke-gcp: helper exited ($?)" if $? != 0
    $out
}

fn GCP::version {
    my $bin = GCP::_shq(GCP::helper_path())
    my $v = qx{$bin --version 2>&1}
    chomp $v
    $v
}

# Returns truthy if ADC creds are reachable.
fn GCP::ping (%opts) {
    my @argv = GCP::_conn_argv(\%opts)
    push @argv, "ping"
    my $cmd = join " ", @argv
    my $out = qx{$cmd 2>/dev/null}
    $? == 0 && $out =~ /\"ok\":\s*true/
}

# Identity / credentials introspection.
fn GCP::auth (%opts) {
    my @argv = GCP::_conn_argv(\%opts)
    push @argv, "auth"
    GCP::_run_json(\@argv)
}

1
