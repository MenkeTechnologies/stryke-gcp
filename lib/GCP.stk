# ── pure helpers (no GCP) ─────────────────────────────────────────────

## Parse a "gs://bucket/object" URI into a hashref { bucket, object } (object
## undef when only a bucket is given).
fn GCP::parse_gs_uri ($uri) {
    GCP::_decode("parse_gs_uri", gcp__parse_gs_uri(to_json({ uri => $uri })))
}

## Build a "gs://bucket/object" URI from parts. $object is optional; a bare
## bucket yields "gs://bucket". Leading slashes on $object are trimmed. Inverse
## of parse_gs_uri.
fn GCP::build_gs_uri ($bucket, $object = undef) {
    GCP::_decode("build_gs_uri",
        gcp__build_gs_uri(to_json({ bucket => $bucket, object => $object })))->{uri}
}

## Convert a "gs://bucket/object" URI to its path-style public download URL
## "https://storage.googleapis.com/bucket/object". Returns a hashref
## { url, bucket, object }.
fn GCP::gs_uri_to_url ($uri) {
    GCP::_decode("gs_uri_to_url", gcp__gs_uri_to_url(to_json({ uri => $uri })))
}

## Convert a GCS download URL (path-style or virtual-hosted-style) back to its
## "gs://bucket/object" URI. Inverse of gs_uri_to_url. Returns a hashref
## { uri, bucket, object }.
fn GCP::url_to_gs_uri ($url) {
    GCP::_decode("url_to_gs_uri", gcp__url_to_gs_uri(to_json({ url => $url })))
}

## Parse a GCP resource name "collection/id/collection/id…" into a hashref
## { parts, pairs => { collection => id }, trailing }.
fn GCP::parse_resource_name ($name) {
    GCP::_decode("parse_resource_name", gcp__parse_resource_name(to_json({ name => $name })))
}

## The parent of a GCP relative resource name — the hierarchy "dirname" that drops
## the trailing collection/id pair. "projects/p/locations/l/clusters/c" → parent
## "projects/p/locations/l", leaf collection "clusters", id "c". A top-level
## resource ("projects/p") has an empty parent and has_parent false; a dangling
## collection (odd segment count) dies. Returns a hashref
## { name, parent, has_parent, collection, id }.
fn GCP::resource_name_parent ($name) {
    GCP::_decode("resource_name_parent", gcp__resource_name_parent(to_json({ name => $name })))
}

## Assemble a GCP resource name from parts — inverse of parse_resource_name.
## %opts: parts (flat arrayref, exact inverse) OR pairs (arrayref of
## [collection, id] or { collection, id }) plus an optional trailing segment.
## Returns the name string.
fn GCP::build_resource_name (%opts) {
    GCP::_decode("build_resource_name", gcp__build_resource_name(to_json(\%opts)))->{name}
}

## Parse a BigQuery fully-qualified table reference into a hashref
## { table_ref, project, dataset, table, legacy }. Standard SQL dots everything
## ("project.dataset.table"); legacy SQL / the bq CLI put a ":" after the project
## ("project:dataset.table"). A project-less "dataset.table" is accepted (project
## undef). dataset and table are always required.
fn GCP::parse_table_ref ($table_ref) {
    GCP::_decode("parse_table_ref", gcp__parse_table_ref(to_json({ table_ref => $table_ref })))
}

## Assemble a BigQuery table reference from parts — the inverse of parse_table_ref.
## %opts: dataset (required), table (required), project (optional), legacy
## (optional; with a project, true → "project:dataset.table", false →
## "project.dataset.table"). Without a project the result is "dataset.table" (and
## legacy then requires a project). No segment may contain "." or ":". Returns a
## hashref { table_ref, project, dataset, table, legacy }.
fn GCP::build_table_ref (%opts) {
    GCP::_decode("build_table_ref", gcp__build_table_ref(to_json(\%opts)))
}

## Validate a GCS bucket name (3-63 chars of [a-z0-9-._], start/end
## alphanumeric, not an IP, no "goog" prefix, no "google"). Underscores are
## allowed (unlike S3). Returns { name, valid, reason }.
fn GCP::valid_bucket_name ($name) {
    GCP::_decode("valid_bucket_name", gcp__valid_bucket_name(to_json({ name => $name })))
}

## Validate a GCP project ID: 6-30 chars of lowercase letters, digits, and
## hyphens; must start with a lowercase letter and must not end with a hyphen.
## Returns a hashref { id, valid, reason } (reason undef when valid).
fn GCP::valid_project_id ($id) {
    GCP::_decode("valid_project_id", gcp__valid_project_id(to_json({ id => $id })))
}

## Validate a Cloud Storage object name against GCS hard rules: 1-1024 UTF-8
## bytes; no CR/LF; not exactly "." or ".."; no ".well-known/acme-challenge/"
## prefix. Returns a hashref { name, valid, reason } (reason undef when valid).
fn GCP::valid_object_name ($name) {
    GCP::_decode("valid_object_name", gcp__valid_object_name(to_json({ name => $name })))
}

## Derive the GCP region from a zone name (us-central1-a → us-central1): the
## zone with its trailing single-letter suffix removed. Returns a hashref
## { zone, region, zone_letter }; dies if the zone is malformed.
fn GCP::region_for_zone ($zone) {
    GCP::_decode("region_for_zone", gcp__region_for_zone(to_json({ zone => $zone })))
}

## Validate a GCP resource label $key/$value per Resource Manager rules: key is
## 1-63 chars, starts with a lowercase letter, lowercase/digit/_/- only; value
## is 0-63 chars of the same charset and may be empty. Returns a hashref
## { key, value, valid, reason }.
fn GCP::valid_label ($key, $value = "") {
    GCP::_decode("valid_label", gcp__valid_label(to_json({ key => $key, value => $value })))
}

## Validate a Pub/Sub resource ID ($id — topic, subscription, schema, or
## snapshot) per Google's naming guidelines: 3-255 chars, starts with a letter,
## must not begin with "goog", and only letters/digits/-/_/./~/+/% allowed. The
## same rule governs all four resource kinds. Returns a hashref { id, valid, reason }.
fn GCP::valid_pubsub_id ($id) {
    GCP::_decode("valid_pubsub_id", gcp__valid_pubsub_id(to_json({ id => $id })))
}

## Validate a GCP service-account ID ($id — the part before the @ in a service
## account email) per the IAM accountId rules: 6-30 chars, RFC1035-compliant —
## only lowercase letters/digits/hyphens, must start with a lowercase letter, and
## must not end with a hyphen. Returns a hashref { id, valid, reason }.
fn GCP::valid_service_account_id ($id) {
    GCP::_decode("valid_service_account_id", gcp__valid_service_account_id(to_json({ id => $id })))
}

## Validate a GCP Secret Manager secret ID ($id) per Create-a-secret: 1-255 chars
## of letters (upper or lower case), numerals, hyphens and underscores — no
## leading-letter or trailing-hyphen restriction (unlike a service-account ID).
## Returns a hashref { id, valid, reason }.
fn GCP::valid_secret_id ($id) {
    GCP::_decode("valid_secret_id", gcp__valid_secret_id(to_json({ id => $id })))
}

## Validate a BigQuery dataset ID ($id) per Google's naming rules: up to 1024
## chars of letters/digits/underscores only — no spaces or "-&@%" specials;
## case-sensitive (a leading underscore marks a hidden dataset). Returns a hashref
## { id, valid, reason }.
fn GCP::valid_dataset_id ($id) {
    GCP::_decode("valid_dataset_id", gcp__valid_dataset_id(to_json({ id => $id })))
}

## Validate a BigQuery table $id — the companion of valid_dataset_id with the
## broader table rules: at most 1024 UTF-8 BYTES (not characters) and Unicode
## letters/numbers plus underscores, dashes, and spaces. Returns a hashref
## { id, valid, reason, bytes } (bytes is the UTF-8 length).
fn GCP::valid_table_id ($id) {
    GCP::_decode("valid_table_id", gcp__valid_table_id(to_json({ id => $id })))
}

